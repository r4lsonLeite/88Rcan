<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Painel de status: legível de relance durante a live -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#455A64"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/idle"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="2"
                android:backgroundTint="#C62828"
                android:text="@string/start"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/stop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/stop"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/section_camera" android:textStyle="bold" />

        <EditText
            android:id="@+id/cameraUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/camera_url_hint"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/cameraUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/camera_user_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/cameraPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/camera_pass_hint"
            android:inputType="textPassword" />

        <TextView style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/section_youtube" android:textStyle="bold" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url_hint"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/streamKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/stream_key_hint"
            android:inputType="textPassword" />

        <TextView style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/section_options" android:textStyle="bold" />

        <CheckBox
            android:id="@+id/audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/audio_label" />

        <CheckBox
            android:id="@+id/splitNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/split_network_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/split_network_help"
            android:textSize="12sp" />

        <Button
            android:id="@+id/batterySettings"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/battery_settings" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
